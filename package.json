{
  "name": "grasping-straws",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "validate": "node scripts/validate-cards.js && node scripts/validate-rules.js",
    "verify": "node scripts/verify.js",
