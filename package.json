{
  "name": "grasping-straws",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "test": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml \"tests/**/*.test.mjs\"",
    "validate": "node scripts/validate-cards.js",
    "verify": "npm run verify:check && npm run verify:e2e",
    "verify:check": "npm run validate && npm run validate:rules && npm run pnp:check && npm run lint && npm run lint:boundaries && npm run check && npm test && npm run build",
    "verify:e2e": "sh scripts/verify-e2e.sh",
    "assets": "node scripts/make-assets.js",
    "print": "node scripts/print-cards.js",
    "print:box": "node scripts/print-box.js",
    "mockup": "node scripts/mockup.js",
    "validate:rules": "node scripts/validate-rules.js",
    "pnp": "node scripts/print-and-play.js",
    "pnp:check": "node scripts/check-pnp-fresh.js",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "astro": "^7.4.13",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "lint-staged": "^17.6.2",
    "playwright": "1.56.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && npm run check"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": "eslint"
  }
}
