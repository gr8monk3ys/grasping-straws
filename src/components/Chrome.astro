---
/*
 * The footer on the card screens (/, /today/, /c/<id>/). It was written
 * out three times; adding a link meant remembering all three, which is
 * exactly how the rules cards nearly drifted. One component now.
 *
 * The prose pages (/about/, /play/, /deck/) end in a .credit line instead
 * and deliberately do not use this — they are read to the bottom, so a
 * fixed set of chrome links there would be redundant with the sentence
 * that already sends you somewhere.
 */
import { DECK_NAME, PHYSICAL_DECK_URL } from "../config";

const physicalHref = PHYSICAL_DECK_URL || "/about/#physical";
---

<footer class="chrome">
  <span class="deck-name">{DECK_NAME}</span>
  <nav>
    <a href="/about/">About</a>
    <a href="/deck/">The deck</a>
    <a href="/play/">Ways to play</a>
    <a href={physicalHref} class="cta">Get the physical deck</a>
  </nav>
</footer>
