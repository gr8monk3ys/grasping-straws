---
/*
 * The masthead. Sits above the content on every page — a running head rather
 * than a footer, which is what puts the wordmark and the deck count where an
 * editorial page would carry them.
 */
import { DECK_NAME, PHYSICAL_DECK_URL } from "../config";
import type { EditionKey } from "../deck/editions";
import { TABLES } from "../deck/site";

interface Props {
  /* the draw screen carries a live count; other pages do not */
  counter?: boolean;
  /* which edition the page belongs to; everything but Night is Paper's */
  edition?: EditionKey;
}
const { counter = false, edition = "paper" } = Astro.props;
// Computed, not hardcoded: a literal here becomes a first-paint lie the
// moment a deck changes size. Drafts never reach the site.
const deckSize = TABLES[edition].cards.length;
// The masthead offers the other deck, by name. "Night" alone would sit
// beside the Light/Dark switch and read as a third theme.
const other = TABLES[edition === "night" ? "paper" : "night"];
const otherLabel = other.edition.name.replace(" edition", " deck");
---

<header class="chrome">
  <a class="deck-name" href="/">{DECK_NAME}</a>

  {
    counter && (
      <p class="tally" id="tally" aria-live="off">
        {/* The two tables look alike, so the second one says which it is.
            The front page stays unmarked: it is the deck people arrive at. */}
        {edition === "night" && (
          <>
            <span class="tally-label">Night</span> <span class="tally-sep">&middot;</span>{" "}
          </>
        )}
        <span class="tally-num" id="tally-drawn">0</span>{" "}
        <span class="tally-sep">/</span>{" "}
        <span class="tally-num" id="tally-total">{deckSize}</span>{" "}
        <span class="tally-label">drawn</span>
      </p>
    )
  }

  <nav>
    {/* One extra masthead link, not three: /play/ is the door to the other
        two — it links on to /deck/ and /today/ — and the masthead already
        needs a second row at 390px with the links it has. */}
    <a href="/play/">Play</a>
    <a href="/about/">About</a>
    <a href={other.home}>{otherLabel}</a>
    {/* "Get the deck" only once there is a deck to get. Until then the
        masthead says nothing: a link that led to "coming soon" was a door
        with a wall behind it. About still says where the deck stands. */}
    {PHYSICAL_DECK_URL && <a href={PHYSICAL_DECK_URL} data-get>Get the deck</a>}
    <button id="theme" class="theme" type="button" aria-label="Switch to dark theme">
      <span class="theme-dot" aria-hidden="true"></span>
      <span class="theme-word" id="theme-word">Light</span>
    </button>
  </nav>
</header>
