---
/*
 * Both decks, in print. Every card grouped by edition and suit, set as a list
 * rather than as clickable faces — this page exists to show what is in the
 * box (the physical deck has no other evidence page), not to let a visitor
 * shop for the card they'd rather have drawn. The deck doesn't negotiate;
 * that rule should survive its own contents page.
 *
 * Built from the card files like everything else, so a card edit lands
 * here at the next build with nothing to keep in step. No JavaScript.
 */
import { ALL_TABLES } from "../deck/site";
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import { DECK_NAME, DECK_VERSION, PHYSICAL_DECK_URL } from "../config";

const description =
  "Every card in Grasping Straws, both editions, grouped by suit — the full contents of each deck.";

// Drafts are reserved ids with no text, held so the printed deck reaches
// one of the printer's fixed tiers. They are not part of the deck anyone
// has, so they are not listed — the same rule the share pages use.
//
// Suits in order of first appearance in the card file, which is the deck's
// own order. Cards with no suit are collected last so none can go unlisted.
const editions = ALL_TABLES.map((table) => {
  const deck = table.cards;
  const suits = [...new Set(deck.map((c) => c.suit).filter(Boolean))];
  const groups = [
    ...suits.map((suit) => ({
      suit,
      cards: deck.filter((c) => c.suit === suit).sort((a, b) => a.id - b.id),
    })),
    { suit: null, cards: deck.filter((c) => !c.suit).sort((a, b) => a.id - b.id) },
  ].filter((g) => g.cards.length > 0);
  return { table, groups };
});
const total = editions.reduce((n, e) => n + e.table.cards.length, 0);

// What each suit is for. Keyed by suit name so a new suit in a card file
// still shows up here with its cards, just without a description.
const BLURB: Record<string, string> = {
  lateral: "For when the approach itself is the problem.",
  sound: "For work you listen to.",
  image: "For work you look at.",
  language: "For work made of words.",
  threshold: "For starting, and for stopping.",
  avoidance: "For what you have been working around.",
  motive: "For why you are making it.",
  protection: "For what you are keeping safe.",
  audience: "For whoever you imagine watching.",
  permission: "For what you are waiting to be allowed.",
};
---

<Base title={`The deck — ${DECK_NAME}`} description={description} bodyClass="about">
  <Chrome />
  <main id="main">
    <span class="glyph page-mark"></span>

    <h1>The deck</h1>

    <p class="lede">
      All {total} cards in both editions, grouped by suit. Reading them straight through is a
      different thing from drawing one &mdash; a deck works because it picks, not you. Consider this
      the contents of the two boxes rather than a menu.
    </p>

    {
      editions.map(({ table, groups }) => (
        <>
          {/* The edition is a heading of its own rank with the suits one
              rank under it, so the outline reads edition, then suit. */}
          <h2 class="edition-head" id={table.edition.key}>
            {table.edition.name}
            <span class="players">
              <a href={table.home}>draw from it</a>
            </span>
          </h2>
          <p>{table.blurb}</p>
          {groups.map((group) => (
            <section class="suit-block">
              <h3>
                {group.suit ?? "Unsuited"}
                <span class="players">{group.cards.length} cards</span>
              </h3>
              {group.suit && BLURB[group.suit] && <p class="suit-blurb">{BLURB[group.suit]}</p>}
              <ol class="deck-list">
                {group.cards.map((card) => (
                  <li>
                    <span class="deck-num">{card.id}</span>
                    <span class="deck-text">{card.text}</span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </>
      ))
    }

    <p class="credit">
      Deck v{DECK_VERSION} &middot; <a href="/">Draw a card</a> &middot;
      <a href="/today/">Today’s card</a> &middot;
      <a href="/play/">Ways to play</a> &middot;
      {
        PHYSICAL_DECK_URL ? (
          <a href={PHYSICAL_DECK_URL} rel="noopener">Get the physical deck</a>
        ) : (
          <a href="/about/#physical">About the physical deck</a>
        )
      }
    </p>
  </main>
</Base>
