---
/*
 * One static page per card, built from public/cards.json. These are what
 * the share control hands out: unlike /#17 (a fragment scrapers never see),
 * /c/17/ puts the card text in the title and OG tags, so a shared link
 * previews the card itself. The page needs no JavaScript.
 */
import cards from "../../../public/cards.json";
import Base from "../../layouts/Base.astro";
import { DECK_NAME, PHYSICAL_DECK_URL } from "../../config";

export function getStaticPaths() {
  return cards.map((card) => ({ params: { id: String(card.id) }, props: { card } }));
}

const { card } = Astro.props;
const title = `“${card.text}” — ${DECK_NAME}`;
const description =
  "A card from Grasping Straws, an original deck of lateral-thinking prompts. Draw your own.";
const physicalHref = PHYSICAL_DECK_URL || "/about/#physical";
---

<Base title={title} description={description}>
  <main class="stage">
    {/* Same deck shell as the draw screen, minus the second face — a shared
        card is already face up and never turns. */}
    <div class="deck" data-edges="3">
      <span class="deck-stack" aria-hidden="true">
        <span class="deck-edge"></span>
        <span class="deck-edge"></span>
        <span class="deck-edge"></span>
      </span>
      <span class="card-shadow card-shadow-ambient" aria-hidden="true"></span>
      <span class="card-shadow card-shadow-contact" aria-hidden="true"></span>
      <div class="card card-static">
        <span class="card-inner">
          <span class="face face-a">
            <span class="card-text">{card.text}</span>
          </span>
        </span>
      </div>
    </div>
    <p class="hint card-page-invite">
      <a href="/">Draw your own card &rarr;</a>
    </p>
  </main>
  <footer class="chrome">
    <span class="deck-name">{DECK_NAME}</span>
    <nav>
      <a href="/about/">About</a>
      <a href={physicalHref} class="cta">Get the physical deck</a>
    </nav>
  </footer>
</Base>
