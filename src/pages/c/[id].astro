---
/*
 * One static page per card, built from public/cards.json. These are what
 * the share control hands out: unlike /#17 (a fragment scrapers never see),
 * /c/17/ puts the card text in the title and OG tags, so a shared link
 * previews the card itself. The page needs no JavaScript.
 */
import cards from "../../../public/cards.json";
import Base from "../../layouts/Base.astro";
import Chrome from "../../components/Chrome.astro";
import { DECK_NAME } from "../../config";

export function getStaticPaths() {
  return cards.map((card) => ({ params: { id: String(card.id) }, props: { card } }));
}

const { card } = Astro.props;
const title = `“${card.text}” — ${DECK_NAME}`;
const description =
  "A card from Grasping Straws, an original deck of lateral-thinking prompts. Draw your own.";
---

<Base title={title} description={description}>
  <main class="stage">
    <div class="card card-static">
      <span class="card-inner">
        <span class="card-text">{card.text}</span>
      </span>
    </div>
    <p class="hint card-page-invite">
      <a href="/">Draw your own card &rarr;</a>
    </p>
  </main>
  <Chrome />
</Base>
