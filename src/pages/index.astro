---
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import { DECK_NAME } from "../config";
import cards from "../../public/cards.json";

// Same rule as the masthead tally: the first-paint count is computed from
// cards.json (drafts excluded), never hardcoded.
const deckSize = cards.filter((c) => !("draft" in c && c.draft)).length;
const description =
  "An original deck of lateral-thinking prompts for breaking creative deadlocks. Tap to draw a card.";
---

<Base title={DECK_NAME} description={description}>
  <Chrome counter />
  <main class="stage">
    {/*
      Three columns so the card stays optically centred while the discard
      pile grows beside it. The left column is the deck's own label; the
      stack itself lives under the card.
    */}
    <div class="table">
      <aside class="pile pile-deck">
        <span class="minipile" id="deck-mini" data-layers="6" aria-hidden="true">
          <span class="minipile-layer"></span>
          <span class="minipile-layer"></span>
          <span class="minipile-layer"></span>
          <span class="minipile-layer"></span>
          <span class="minipile-layer"></span>
          <span class="minipile-layer"></span>
        </span>
        <span class="pile-count" id="left-count">{deckSize}</span>
        <span class="pile-label">in the deck</span>
      </aside>

      <div class="deck" id="deck" data-edges="3">
        <span class="deck-stack" id="deck-stack" aria-hidden="true">
          <span class="deck-edge"></span>
          <span class="deck-edge"></span>
          <span class="deck-edge"></span>
        </span>
        <span class="card-shadow card-shadow-ambient" aria-hidden="true"></span>
        <span class="card-shadow card-shadow-contact" aria-hidden="true"></span>
        <button id="card" class="card" aria-describedby="draw-desc">
          <span class="card-inner" id="card-inner">
            <span class="spine spine-l" aria-hidden="true"></span>
            <span class="spine spine-r" aria-hidden="true"></span>
            <span class="face face-a" id="face-a" aria-hidden="false">
              <span class="card-mark" id="card-mark">
                <span class="glyph"></span>
                <span class="card-wordmark">{DECK_NAME}</span>
              </span>
              <span class="card-text" hidden></span>
            </span>
            <span class="face face-b" id="face-b" aria-hidden="true">
              <span class="card-text"></span>
            </span>
          </span>
        </button>
      </div>

      {/* Cards no longer in play, grouped: the discard thickens as the deck
          thins, and the shelf holds whatever was set aside. Both are real
          piles — you can pick either one up and look through it. */}
      <div class="pile-column">
        <button class="pile pile-discard" id="discard-open" type="button" aria-haspopup="dialog" disabled>
          <span class="minipile is-discard" id="discard" data-layers="0" aria-hidden="true">
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
          </span>
          <span class="pile-count" id="drawn-count">0</span>
          <span class="pile-label">discarded</span>
        </button>

        <button class="pile pile-aside" id="aside-open" type="button" aria-haspopup="dialog" disabled>
          <span class="minipile is-aside" id="aside" data-layers="0" aria-hidden="true">
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
            <span class="minipile-layer"></span>
          </span>
          <span class="pile-count" id="aside-count">0</span>
          {/* "kept", not "set aside": the control beside the card already
              says "set aside", and having the verb and the place share a
              label made the two read as the same thing. */}
          <span class="pile-label">kept</span>
        </button>
      </div>
    </div>

    <span id="draw-desc" class="sr-only">
      Draws the next card from the deck. You can also throw the card aside with
      a drag.
    </span>
    <div class="hint-slot">
      <p class="hint" id="hint" aria-hidden="true">
        <span class="hint-touch">tap to draw, or throw the card</span>
        <span class="hint-pointer">press space, click, or throw the card</span>
      </p>
      <span class="card-actions">
        <button id="keep" class="share" aria-pressed="false">set aside</button>
        <button id="share" class="share">share this card</button>
      </span>
    </div>
    {/*
      Picking a pile up. A native <dialog> rather than a div: showModal()
      brings the focus trap, the Esc key, inertness of the page behind and
      ::backdrop with no script of our own.
    */}
    <dialog class="spread" id="spread" aria-labelledby="spread-title">
      <div class="spread-head">
        <h2 class="spread-title" id="spread-title"></h2>
        <button class="spread-close" id="spread-close" type="button" aria-label="close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <ul class="spread-list" id="spread-list"></ul>
    </dialog>

    <p class="sr-only" aria-live="polite" id="live"></p>
    <noscript>
      <p class="hint">
        The deck needs JavaScript to shuffle — the cards themselves are just{" "}
        <a href="/cards.json">a JSON file</a>.
      </p>
    </noscript>
  </main>
</Base>

<script>
  import "../scripts/app";
</script>
