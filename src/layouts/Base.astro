---
import "../styles/global.css";
import { DECK_NAME } from "../config";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={DECK_NAME} />
    {Astro.site && <meta property="og:image" content={new URL("/og.png", Astro.site).href} />}
    {Astro.site && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#b4bdbb" />
    {
      /*
      Must run before first paint, or a visitor who chose dark gets a
      frame of light on every navigation. Inline and blocking on purpose:
      this is the one thing on the site that cannot be deferred.
    */
    }
    <script is:inline>
      try {
        var t = localStorage.getItem("grasping-straws.theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {
        /* storage unavailable — fall through to the system preference */
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="preload"
      href="/fonts/EBGaramond-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class={bodyClass}>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Theme: match system. Switch to light."
    >
      {/* Half-filled circle: following whatever the system is doing. */}
      <svg data-icon="system" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.3"></circle>
        <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
      </svg>
      <svg data-icon="light" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="3.15" stroke="currentColor" stroke-width="1.3"></circle>
        <path
          d="M8 .9v1.9M8 13.2v1.9M15.1 8h-1.9M2.8 8H.9M13.02 13.02l-1.34-1.34M4.32 4.32 2.98 2.98M2.98 13.02l1.34-1.34M11.68 4.32l1.34-1.34"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"></path>
      </svg>
      <svg data-icon="dark" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M13.4 9.9A5.9 5.9 0 0 1 6.1 2.6a5.9 5.9 0 1 0 7.3 7.3z"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linejoin="round"></path>
      </svg>
    </button>
    <slot />
    <script>
      import "../scripts/theme";
    </script>
  </body>
</html>
